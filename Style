{ box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; background: #0b0b0d; color: #f5f5f5; font-family: Arial, Helvetica, sans-serif; line-height: 1.6; }
.header { min-height: 72px; padding: 14px 7%; display: flex; align-items: center; justify-content: space-between; gap: 20px; background: #111114; border-bottom: 1px solid #29292e; position: sticky; top: 0; z-index: 10; }
.logo { color: white; font-weight: 900; font-size: 22px; text-decoration: none; letter-spacing: 1px; }
.logo span, h1 span { color: #ff3b30; }
nav { display: flex; gap: 24px; }
nav a { color: #ddd; text-decoration: none; font-weight: 700; }
nav a:hover { color: #ff5148; }
.menu-button { display: none; color: white; background: transparent; border: 0; font-size: 27px; }
.hero { min-height: 490px; display: flex; align-items: center; padding: 70px 8%; background: linear-gradient(90deg, rgba(0,0,0,.94), rgba(0,0,0,.55)), radial-gradient(ellipse at 75% 45%, #6b2420 0, #241416 35%, #101014 75%); }
.hero-content { max-width: 650px; }
.eyebrow { color: #ff5148; font-size: 12px; font-weight: 900; letter-spacing: 2px; }
h1 { font-size: clamp(42px, 8vw, 76px); line-height: 1; margin: 12px 0; font-weight: 900; }
h2 { font-size: clamp(25px, 4vw, 38px); margin: 10px 0 16px; }
.hero p:not(.eyebrow) { color: #c8c8ce; max-width: 540px; }
.button { display: inline-block; margin-top: 18px; padding: 12px 22px; border-radius: 7px; background: #f23830; color: white; font-weight: 800; text-decoration: none; }
.button:hover { background: #ff5a50; }
.section { padding: 70px 8%; }
.section > h2 { margin-top: 0; }
.cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
.server-card { padding: 25px; background: #17171c; border: 1px solid #303038; border-radius: 13px; }
.server-icon { color: #ff5148; font-size: 30px; font-weight: 900; }
.server-card h3 { margin-bottom: 6px; }
.server-card p, .about p, .download p { color: #bdbdc5; }
.status { display: inline-block; color: #ff8b83; font-size: 13px; font-weight: 700; }
.status.muted { color: #aaa; }
.about, .download { background: #131317; }
.download { text-align: center; }
.download-note { font-size: 13px; }
.secondary { background: transparent; border: 1px solid #ff5148; }
footer { padding: 24px 8%; color: #888; border-top: 1px solid #29292e; font-size: 13px; }
@media (max-width: 650px) {
  .header { padding: 12px 5%; }
  .menu-button { display: block; }
  nav { display: none; position: absolute; top: 65px; left: 0; right: 0; padding: 18px 5%; background: #151519; flex-direction: column; gap: 14px; border-bottom: 1px solid #333; }
  nav.open { display: flex; }
  .hero { min-height: 440px; padding: 55px 6%; }
  .section { padding: 52px 6%; }
  .cards { grid-template-columns: 1fr; }
}
